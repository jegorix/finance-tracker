<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Finance Tracker All Endpoints" enabled="true">
      <stringProp name="TestPlan.comments">Covers all current Finance Tracker endpoints, including lab 6 async and race-condition demos.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="host" elementType="Argument">
            <stringProp name="Argument.name">host</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="port" elementType="Argument">
            <stringProp name="Argument.name">port</stringProp>
            <stringProp name="Argument.value">${__P(port,8080)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="protocol" elementType="Argument">
            <stringProp name="Argument.name">protocol</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="basePath" elementType="Argument">
            <stringProp name="Argument.name">basePath</stringProp>
            <stringProp name="Argument.value">${__P(basePath,/api/v1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="targetRps" elementType="Argument">
            <stringProp name="Argument.name">targetRps</stringProp>
            <stringProp name="Argument.value">${__P(targetRps,150)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="targetThroughputPerMinute" elementType="Argument">
            <stringProp name="Argument.name">targetThroughputPerMinute</stringProp>
            <stringProp name="Argument.value">${__P(targetThroughputPerMinute,9000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="budgetStartDate" elementType="Argument">
            <stringProp name="Argument.name">budgetStartDate</stringProp>
            <stringProp name="Argument.value">${__P(budgetStartDate,2026-04-01)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="budgetEndDate" elementType="Argument">
            <stringProp name="Argument.name">budgetEndDate</stringProp>
            <stringProp name="Argument.value">${__P(budgetEndDate,2026-04-30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="budgetPatchedEndDate" elementType="Argument">
            <stringProp name="Argument.name">budgetPatchedEndDate</stringProp>
            <stringProp name="Argument.value">${__P(budgetPatchedEndDate,2026-05-10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="txOccurredAt" elementType="Argument">
            <stringProp name="Argument.name">txOccurredAt</stringProp>
            <stringProp name="Argument.value">${__P(txOccurredAt,2026-04-05T10:00:00)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="txBulkOccurredAt" elementType="Argument">
            <stringProp name="Argument.name">txBulkOccurredAt</stringProp>
            <stringProp name="Argument.value">${__P(txBulkOccurredAt,2026-04-05T11:00:00)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="txUpdatedAt" elementType="Argument">
            <stringProp name="Argument.name">txUpdatedAt</stringProp>
            <stringProp name="Argument.value">${__P(txUpdatedAt,2026-04-05T12:00:00)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="txSearchStart" elementType="Argument">
            <stringProp name="Argument.name">txSearchStart</stringProp>
            <stringProp name="Argument.value">${__P(txSearchStart,2026-04-01T00:00:00)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="txSearchEnd" elementType="Argument">
            <stringProp name="Argument.name">txSearchEnd</stringProp>
            <stringProp name="Argument.value">${__P(txSearchEnd,2026-04-06T23:59:59)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="asyncOccurredAt" elementType="Argument">
            <stringProp name="Argument.name">asyncOccurredAt</stringProp>
            <stringProp name="Argument.value">${__P(asyncOccurredAt,2026-04-05T13:00:00)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="asyncWaitMillis" elementType="Argument">
            <stringProp name="Argument.name">asyncWaitMillis</stringProp>
            <stringProp name="Argument.value">${__P(asyncWaitMillis,30000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="uniqueSuffix" elementType="Argument">
            <stringProp name="Argument.name">uniqueSuffix</stringProp>
            <stringProp name="Argument.value">${__time(yyyyMMddHHmmssSSS,)}_${__threadNum}_${__Random(1000,999999,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="All Endpoints Flow">
        <stringProp name="ThreadGroup.num_threads">${__P(users,50)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampUp,1)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">${__P(loops,1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
